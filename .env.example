# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会上传

# ── MySQL（docker compose 自动读取本文件同目录的 .env）──
MYSQL_ROOT_PASSWORD=root_dev_pwd
MYSQL_DATABASE=sensor
MYSQL_USER=sensor
MYSQL_PASSWORD=sensor_dev_pwd

# ── LLM 归因（可选，留空则自动降级为规则引擎）──
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
